# Server
PORT=8787
NODE_ENV=development

# Trading modes (DO NOT ENABLE REAL TRADING IN DEV)
ATSMATRIX_REAL_TRADING_ENABLED=false

# Chain RPCs (optional - used only for REAL mode with verified adapters)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-KEY
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR-KEY
# BSC_RPC_URL=https://bsc-dataseed1.binance.org
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR-KEY
# ROBINHOOD_RPC_URL=https://api.robinhood.chain/

# Private Keys (NEVER commit these - use secret manager in production)
# SOLANA_PRIVATE_KEY=
# ETHEREUM_PRIVATE_KEY=
# DO NOT PUT PRIVATE KEYS IN .env FILES - USE SECRET MANAGERS
